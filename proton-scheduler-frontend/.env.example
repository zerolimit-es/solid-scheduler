# SolidScheduler Frontend Configuration
#
# The frontend calls the API on its own origin (/api/...), so it needs no
# build-time settings: in production the reverse proxy routes /api to the
# backend, and in development Vite proxies it.

# Development only: where the Vite dev server forwards /api requests
# (default http://localhost:3001)
# VITE_PROXY_TARGET=http://localhost:3001
